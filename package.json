{
  "name": "profit-loop-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/core/**/*.test.ts\" \"src/lib/*.test.ts\" \"src/components/**/*.test.ts\" \"src/api/**/*.test.ts\" \"src/views/**/*.test.ts\"",
    "test:server": "tsx --test --test-concurrency=1 \"src/lib/api/functions/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/lib/api/functions/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/lib/api/functions/scripts/seed.ts",
    "db:demo": "tsx --env-file-if-exists=.env.local src/lib/api/functions/scripts/demoSeed.ts",
    "job:recurring": "tsx --env-file-if-exists=.env.local src/lib/api/functions/scripts/recurringJob.ts",
    "db:merge-categories": "tsx --env-file-if-exists=.env.local src/lib/api/functions/scripts/mergeDuplicateCategories.ts",
    "auth:claim": "tsx --env-file-if-exists=.env.local src/lib/api/functions/scripts/claimLocalData.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.545.0",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
